    (rule:"PUN-PAREN-006",chapter:"08",form:"Egyes szavak ige és főnév is lehetnek (pl. les, nyom)."),
    (rule:"PUN-PAREN-006",chapter:"08",form:"Ne felejtsd el (holnap reggel)!"),
    (rule:"PUN-PAREN-007",chapter:"08",form:"Mindenki egyetértett. (A többiek el sem jöttek.)"),
    (rule:"PUN-PAREN-009",chapter:"08",form:"A mohácsi csata (1526) sorsdöntő volt."),
