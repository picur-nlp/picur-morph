    (rule:"PUN-QUOT-001",chapter:"08",form:"„Azt mondta: »gyere«”"),
    (rule:"PUN-QUOT-002",chapter:"08",form:"„Így szólt: »Hívd ide a ’kis herceget’!«”"),
    (rule:"PUN-QUOT-003",chapter:"08",form:"a „hurkatöltőjéből” ömlik"),
    (rule:"PUN-QUOT-004",chapter:"08",form:"Kölcsey írta: „Ismerni a jót könnyebb.”"),
    (rule:"PUN-QUOT-004",chapter:"08",form:"Megkérdezte: „Mi a neved?”"),
    (rule:"PUN-QUOT-005",chapter:"08",form:"„Holnap jövök” – ígérte Anna."),
    (rule:"PUN-QUOT-005",chapter:"08",form:"„Ki az?” – szólt ki valaki."),
    (rule:"PUN-QUOT-006",chapter:"08",form:"„A nyelv – írja a szerző – élő rendszer.”"),
    (rule:"PUN-QUOT-006",chapter:"08",form:"„Eljössz – kérdezte –, ha hívlak?”"),
    (rule:"PUN-QUOT-007",chapter:"08",form:"A „rendületlenül” jelszóvá vált."),
    (rule:"PUN-QUOT-007",chapter:"08",form:"Szerinte a munka „a szabadság útja”."),
    (rule:"PUN-QUOT-009",chapter:"08",form:"Ki mit tud? – kérdezzük tréfásan."),
    (rule:"PUN-QUOT-009",chapter:"08",form:"Lassan járj, tovább érsz – mondja a közmondás."),
    (rule:"PUN-QUOT-010",chapter:"08",form:"Megkaptam a „szíves” válaszát."),
    (rule:"PUN-QUOT-011",chapter:"08",form:"Olvastad az „Egri csillagok”-at?"),
    (rule:"PUN-QUOT-011",chapter:"08",form:"a „Pál utcai fiúk”-ról"),
    (rule:"PUN-QUOT-012",chapter:"08",form:"– Gyere – intett –, és hozd a kulcsot!"),
    (rule:"PUN-QUOT-012",chapter:"08",form:"– Jössz? – kérdezte. – Várunk."),
    (rule:"PUN-QUOT-012",chapter:"08",form:"– Nem tudom – felelte halkan."),
    (rule:"PUN-QUOT-013",chapter:"08",form:"– kenyér"),
    (rule:"PUN-QUOT-013",chapter:"08",form:"– tej"),
    (rule:"PUN-QUOT-014",chapter:"08",form:"A felirat: „Itt nyugszik »a vándor«.”"),
    (rule:"PUN-QUOT-016",chapter:"08",form:"-l ’valamilyennek látszik’"),
    (rule:"PUN-QUOT-016",chapter:"08",form:"ház ’épület’"),
