// Curated supplement, hand-written from the rulebook. Not generated.
//
// morphdb has no entry at all for the sz-d(-v) verbs of `VRB-STEM-012`, which the induced list
// `local/lists/sz-d-verbs.tsv` confirms independently (`morphdb=-`, corpus 284,155 : 2 for
// `alszik`). They are a closed class, so they are stated here with the `d` stem the rulebook
// itself lists, because nothing derives `alud-` from `alsz-`: `alud-` and `nyugod-` are both back
// yet take different vowels.
//
// A supplement row REPLACES the converted entry for the same lemma and part of speech, so it is
// also where a lexical property the rulebook states but the conversion did not carry is stated.
//
// Rules: VRB-STEM-012, VRB-PAST-006
[
    // `lat` is the single exception to VRB-PAST-006: every other t-final stem that is not a
    // polysyllabic short-vowel one takes `-Ott-` before a person suffix, but this one takes `-t-`
    // (`lattam`, not `*latottam`). One item, so it is stated rather than ruled.
    (lemma:"lát",pos:Verb,traits:[Transitive,PastNonfinalT]),

    // Function words. morphdb keeps these in `art.lexicon`, `conj.lexicon`, `det.lexicon` and
    // `pronoun.lexicon`, none of which the converter reads, so the most frequent words in any
    // Hungarian text were absent and a checker flagged every `a` and `az`. They are closed classes
    // the rulebook enumerates, so they are stated rather than induced.
    //
    // The articles are the only true determiners left here: they never inflect. Everything else in
    // the quantifier series does (`annyit`, `mennyit`, `néhányat`), so it is pronominal.
    //
    // Conjunctions are no longer listed here: `conj.lexicon` is read now and supplies them.
    //
    // Rules: PND-ART-001 (a ~ az), PND-ART-009 (egy), PND-PERS-001 (personal), PND-DEM-001.
    (lemma:"a",pos:Determiner,traits:[Article]),
    (lemma:"az",pos:Determiner,traits:[Article,Back]),
    // `az` is also the distal demonstrative pronoun, which unlike the article inflects: `azt`,
    // `abban`, `azok`. PND-DEM-001.
    (lemma:"az",pos:Pronoun,traits:[Back,DemonstrativeZ]),
    // PND-DEM-007's internal determiners. `e`, `ez`, `a` and `az` are entries already, and
    // `ezen`/`azon` fall out as the superessive of the pronoun, so only the `-me`/`-ma` pair is
    // left: they do not inflect, and the reinforcer occurs nowhere else in the language.
    (lemma:"eme",pos:Determiner),
    (lemma:"ama",pos:Determiner,traits:[Back]),
    (lemma:"én",pos:Pronoun),
    (lemma:"te",pos:Pronoun),
    (lemma:"ő",pos:Pronoun),
    (lemma:"mi",pos:Pronoun),
    (lemma:"ti",pos:Pronoun),
    (lemma:"ők",pos:Pronoun),
    // PND-DEM-002: the final `z` assimilates to a consonant-initial suffix, which is a property of
    // these stems and of nothing else in the language.
    (lemma:"ez",pos:Pronoun,traits:[DemonstrativeZ]),
    (lemma:"emez",pos:Pronoun,traits:[DemonstrativeZ]),
    (lemma:"amaz",pos:Pronoun,traits:[Back,DemonstrativeZ]),
    (lemma:"ugyanez",pos:Pronoun,traits:[DemonstrativeZ]),
    (lemma:"ugyanaz",pos:Pronoun,traits:[Back,DemonstrativeZ]),
    (lemma:"mindez",pos:Pronoun,traits:[DemonstrativeZ]),
    (lemma:"mindaz",pos:Pronoun,traits:[Back,DemonstrativeZ]),

    // The reflexive. PND-REFL-001 gives it the stem `mag-` with possessive personal suffixes and a
    // back, lowering linking vowel, and PND-REFL-002 says the cases then attach regularly. That is
    // the whole paradigm: `magam`, `magát`, `magunkkal` and the rest fall out of the ordinary
    // possessive and case machinery, so only the stem is stated. It is a separate lexeme from the
    // noun `mag` 'seed', which is a v-stem taking `magja` and `magvom`.
    //
    // PND-REFL-003 forms the emphatic compounds with the same stem.
    //
    // Rules: PND-REFL-001, PND-REFL-002, PND-REFL-003
    (lemma:"mag",pos:Pronoun,traits:[Back,Low]),
    (lemma:"önmag",pos:Pronoun,traits:[Back,Low]),
    (lemma:"önnönmag",pos:Pronoun,traits:[Back,Low]),
    (lemma:"egymag",pos:Pronoun,traits:[Back,Low]),
    // PND-DEM-002 exceptions: historical formations that the z-assimilation does not derive.
    (lemma:"eddig",pos:Adverb),
    (lemma:"addig",pos:Adverb),
    // The literary 3sg of `elé`, a lative written onto the postposition, which PND-PERS-004
    // (zero or `-je` after `é`) does not derive.
    (lemma:"elébe",pos:Postposition),
    // NOM-PL: a nominalised adjective with a noun sense of its own is non-lowering in that sense.
    // NOM-ACC-009: the `ns` cluster takes the bare `-t` lexically (`protestánst` 341 :
    // `protestánsot` 1 [WC2]).
    (lemma:"protestáns",pos:Noun,traits:[BareAccusative]),
    // DER-NOUN-014: the `-(O)s` person noun is P-dom, so it is listed; non-lowering, unlike the
    // adjective it converts (`deszantost` 30, `légideszantost` 4, `deszantosat` 0 [WC2]).
    (lemma:"deszantos",pos:Noun),
    // NOM-ACC-009: `nonszenszt` 69 : `nonszenszot` 0 [WC2].
    (lemma:"nonszensz",pos:Noun,traits:[BareAccusative]),
    // ORT-TOG-026: the two preverbs that stand in front of a prefixed verb.
    (lemma:"újra",pos:Preverb,traits:[Stacking]),
    (lemma:"tovább",pos:Preverb,traits:[Stacking]),
    (lemma:"ekképpen",pos:Adverb),
    (lemma:"akképpen",pos:Adverb),
    (lemma:"ki",pos:Pronoun),
    // `mely` ends in a coronal sonorant, so the computed accusative is the bare `*melyt`; the
    // attested form is `melyet`. NOM-ACC-006.
    (lemma:"mely",pos:Pronoun,traits:[LinkedAccusative]),
    (lemma:"melyik",pos:Pronoun),
    // The relative series is `a-` plus an interrogative, and DER-COMP-008 makes the suffix follow
    // the last member: `aki` gives `akinek`, not `*akinak`, although its first vowel is back. The
    // seam offset is what carries that, so no harmony trait is needed.
    (lemma:"aki",parts:[1],pos:Pronoun),
    (lemma:"ami",parts:[1],pos:Pronoun),
    (lemma:"amely",parts:[1],pos:Pronoun,traits:[LinkedAccusative]),
    (lemma:"amelyik",parts:[1],pos:Pronoun),
    (lemma:"amennyi",parts:[1],pos:Pronoun),
    (lemma:"ahány",parts:[1],pos:Pronoun),
    (lemma:"annyi",pos:Pronoun,traits:[SingularOnly]),
    (lemma:"ennyi",pos:Pronoun,traits:[SingularOnly]),
    (lemma:"maga",pos:Pronoun),
    (lemma:"ön",pos:Pronoun),

    // NOM-STEM-010 corrections. The conversion gave `só`, `nő` and `fő` v-stem traits, but the rule
    // names them explicitly as non-v-stems of the same shape (`sók`, `nők`, `fők`, `főt`), and the
    // corpus agrees: `sót` 121,591 : `savat` 7,585, where `savat` belongs to the separate lemma
    // `sav`. Without this, `sót` and `sók` were rejected outright.
    (lemma:"só",pos:Noun,traits:[Low]),
    (lemma:"nő",pos:Noun,traits:[Low]),
    (lemma:"fő",pos:Noun,traits:[Low]),
    // The stated exceptions of NOM-STEM-010: these alternate in the plural but keep the free stem
    // in the accusative and superessive (`szót`, `szón`, but `szavak`).
    (lemma:"szó",pos:Noun,traits:[Low,VStem,OaStem,FreeStemAccSup]),
    // `jó` in that rule is the noun 'asset', not the adjective. The corpus keeps them apart and
    // has no v-stem form of the adjective at all: `jót` 520,066 and `jók` 259,323 on lemma `jó`
    // tagged Adj, while `javak` 115,050 and `javakat` 22,931 are tagged on a lemma `javak` of
    // their own. Giving the adjective the v-stem traits made `jók` a rejected word.
    (lemma:"jó",pos:Adjective,traits:[Low]),
    // PH-VSTEM-002 is explicit that `szú` is *not* a v-stem: `szuvak` is rejected and `szúk` has
    // 510 hits. Only the lexicalised adjective `szuvas` survives.
    (lemma:"szú",pos:Noun,traits:[Low]),

    // The words four of the abbreviations below share their letters with, restated from the
    // conversion because an abbreviation row replaces the converted row of its lemma: `máj`
    // 'liver' (`májat` 22,656, `májak` 261 : `májok` 4 [WC2], NOM-LOW-008), `dag` 'swelling',
    // `prof` and `áll` 'chin'.
    (lemma:"máj",pos:Noun,traits:[Low]),
    (lemma:"dag",pos:Noun,traits:[AlternationOptional]),
    (lemma:"prof",pos:Noun,traits:[PossessiveJa]),
    (lemma:"áll",pos:Noun,traits:[Low,PossessiveA]),

    // Unit symbols of ORT-ABBR-006 and the common lowercase acronyms, which take a suffix after a
    // hyphen exactly as the ORT-ABBR-019 abbreviations do (`kg-nak`, `tbc-s`).
    //
    // Rules: ORT-ABBR-006, ORT-ABBR-009, ORT-ABBR-014
    (lemma:"cm",pos:Noun,traits:[Abbreviation]),
    (lemma:"m",pos:Noun,traits:[Abbreviation]),
    (lemma:"km",pos:Noun,traits:[Abbreviation]),
    (lemma:"dl",pos:Noun,traits:[Abbreviation]),
    (lemma:"l",pos:Noun,traits:[Abbreviation]),
    (lemma:"dkg",pos:Noun,traits:[Abbreviation]),
    (lemma:"dag",pos:Noun,traits:[Abbreviation]),
    (lemma:"kg",pos:Noun,traits:[Abbreviation]),
    (lemma:"mg",pos:Noun,traits:[Abbreviation]),
    (lemma:"g",pos:Noun,traits:[Abbreviation]),
    (lemma:"min",pos:Noun,traits:[Abbreviation]),
    (lemma:"s",pos:Noun,traits:[Abbreviation]),
    (lemma:"h",pos:Noun,traits:[Abbreviation]),
    (lemma:"W",pos:Noun,traits:[Abbreviation]),
    (lemma:"V",pos:Noun,traits:[Abbreviation]),
    (lemma:"A",pos:Noun,traits:[Abbreviation]),
    (lemma:"Hz",pos:Noun,traits:[Abbreviation]),
    (lemma:"GHz",pos:Noun,traits:[Abbreviation]),
    (lemma:"MHz",pos:Noun,traits:[Abbreviation]),
    (lemma:"kB",pos:Noun,traits:[Abbreviation]),
    (lemma:"MB",pos:Noun,traits:[Abbreviation]),
    (lemma:"GB",pos:Noun,traits:[Abbreviation]),
    (lemma:"TB",pos:Noun,traits:[Abbreviation]),
    (lemma:"kWh",pos:Noun,traits:[Abbreviation]),
    (lemma:"db",pos:Noun,traits:[Abbreviation]),
    (lemma:"ha",pos:Noun,traits:[Abbreviation]),
    (lemma:"t",pos:Noun,traits:[Abbreviation]),
    (lemma:"mol",pos:Noun,traits:[Abbreviation]),
    (lemma:"cd",pos:Noun,traits:[Abbreviation]),
    (lemma:"K",pos:Noun,traits:[Abbreviation]),
    (lemma:"N",pos:Noun,traits:[Abbreviation]),
    (lemma:"J",pos:Noun,traits:[Abbreviation]),
    (lemma:"Pa",pos:Noun,traits:[Abbreviation]),
    (lemma:"Ω",pos:Noun,traits:[Abbreviation]),
    (lemma:"tbc",pos:Noun,traits:[Abbreviation]),
    (lemma:"tv",pos:Noun,traits:[Abbreviation]),
    (lemma:"dvd",pos:Noun,traits:[Abbreviation]),
    (lemma:"sms",pos:Noun,traits:[Abbreviation]),
    (lemma:"pc",pos:Noun,traits:[Abbreviation]),
    (lemma:"wc",pos:Noun,traits:[Abbreviation]),
    (lemma:"km²",pos:Noun,traits:[Abbreviation]),
    (lemma:"m²",pos:Noun,traits:[Abbreviation]),

    // The standard abbreviation list of ORT-ABBR-019, extracted from the rule's own Output field.
    // A period normally follows, and the tokeniser strips it, so the bare form is what a checker
    // sees. Multi-word entries (`a. m.`, `Kr. e.`) are omitted: they are not single tokens.
    //
    // Rules: ORT-ABBR-019, ORT-ABBR-004
    (lemma:"Bp",pos:Noun,traits:[Abbreviation]),
    (lemma:"D",pos:Noun,traits:[Abbreviation]),
    (lemma:"DK",pos:Noun,traits:[Abbreviation]),
    (lemma:"DNy",pos:Noun,traits:[Abbreviation]),
    (lemma:"Ft",pos:Noun,traits:[Abbreviation]),
    (lemma:"NB",pos:Noun,traits:[Abbreviation]),
    (lemma:"Ny",pos:Noun,traits:[Abbreviation]),
    (lemma:"Pf",pos:Noun,traits:[Abbreviation]),
    (lemma:"Szt",pos:Noun,traits:[Abbreviation]),
    (lemma:"Ui",pos:Noun,traits:[Abbreviation]),
    (lemma:"aug",pos:Noun,traits:[Abbreviation]),
    (lemma:"bek",pos:Noun,traits:[Abbreviation]),
    (lemma:"br",pos:Noun,traits:[Abbreviation]),
    (lemma:"bt",pos:Noun,traits:[Abbreviation]),
    (lemma:"c",pos:Noun,traits:[Abbreviation]),
    (lemma:"csüt",pos:Noun,traits:[Abbreviation]),
    (lemma:"de",pos:Noun,traits:[Abbreviation]),
    (lemma:"dec",pos:Noun,traits:[Abbreviation]),
    (lemma:"dr",pos:Noun,traits:[Abbreviation]),
    (lemma:"du",pos:Noun,traits:[Abbreviation]),
    (lemma:"em",pos:Noun,traits:[Abbreviation]),
    (lemma:"ev",pos:Noun,traits:[Abbreviation]),
    (lemma:"eü",pos:Noun,traits:[Abbreviation]),
    (lemma:"febr",pos:Noun,traits:[Abbreviation]),
    (lemma:"felv",pos:Noun,traits:[Abbreviation]),
    (lemma:"ffi",pos:Noun,traits:[Abbreviation]),
    (lemma:"ford",pos:Noun,traits:[Abbreviation]),
    (lemma:"fszla",pos:Noun,traits:[Abbreviation]),
    (lemma:"fszt",pos:Noun,traits:[Abbreviation]),
    (lemma:"gimn",pos:Noun,traits:[Abbreviation]),
    (lemma:"gk",pos:Noun,traits:[Abbreviation]),
    (lemma:"gr",pos:Noun,traits:[Abbreviation]),
    (lemma:"hg",pos:Noun,traits:[Abbreviation]),
    (lemma:"honv",pos:Noun,traits:[Abbreviation]),
    (lemma:"id",pos:Noun,traits:[Abbreviation]),
    (lemma:"ifj",pos:Noun,traits:[Abbreviation]),
    (lemma:"ig",pos:Noun,traits:[Abbreviation]),
    (lemma:"igh",pos:Noun,traits:[Abbreviation]),
    (lemma:"ill",pos:Noun,traits:[Abbreviation]),
    (lemma:"isk",pos:Noun,traits:[Abbreviation]),
    (lemma:"jan",pos:Noun,traits:[Abbreviation]),
    (lemma:"júl",pos:Noun,traits:[Abbreviation]),
    (lemma:"jún",pos:Noun,traits:[Abbreviation]),
    (lemma:"kb",pos:Noun,traits:[Abbreviation]),
    (lemma:"ker",pos:Noun,traits:[Abbreviation]),
    (lemma:"kft",pos:Noun,traits:[Abbreviation]),
    (lemma:"kkt",pos:Noun,traits:[Abbreviation]),
    (lemma:"krt",pos:Noun,traits:[Abbreviation]),
    (lemma:"köv",pos:Noun,traits:[Abbreviation]),
    (lemma:"max",pos:Noun,traits:[Abbreviation]),
    (lemma:"mb",pos:Noun,traits:[Abbreviation]),
    (lemma:"mfszt",pos:Noun,traits:[Abbreviation]),
    (lemma:"máj",pos:Noun,traits:[Abbreviation]),
    (lemma:"márc",pos:Noun,traits:[Abbreviation]),
    (lemma:"nov",pos:Noun,traits:[Abbreviation]),
    (lemma:"nyrt",pos:Noun,traits:[Abbreviation]),
    (lemma:"okl",pos:Noun,traits:[Abbreviation]),
    (lemma:"okt",pos:Noun,traits:[Abbreviation]),
    (lemma:"olv",pos:Noun,traits:[Abbreviation]),
    (lemma:"ov",pos:Noun,traits:[Abbreviation]),
    (lemma:"pl",pos:Noun,traits:[Abbreviation]),
    (lemma:"prof",pos:Noun,traits:[Abbreviation]),
    (lemma:"pu",pos:Noun,traits:[Abbreviation]),
    (lemma:"pü",pos:Noun,traits:[Abbreviation]),
    (lemma:"ref",pos:Noun,traits:[Abbreviation]),
    (lemma:"rt",pos:Noun,traits:[Abbreviation]),
    (lemma:"rtg",pos:Noun,traits:[Abbreviation]),
    (lemma:"stb",pos:Noun,traits:[Abbreviation]),
    (lemma:"sz",pos:Noun,traits:[Abbreviation]),
    (lemma:"szept",pos:Noun,traits:[Abbreviation]),
    (lemma:"szerk",pos:Noun,traits:[Abbreviation]),
    (lemma:"szla",pos:Noun,traits:[Abbreviation]),
    (lemma:"szül",pos:Noun,traits:[Abbreviation]),
    (lemma:"tc",pos:Noun,traits:[Abbreviation]),
    (lemma:"tel",pos:Noun,traits:[Abbreviation]),
    (lemma:"ti",pos:Noun,traits:[Abbreviation]),
    (lemma:"tkp",pos:Noun,traits:[Abbreviation]),
    (lemma:"tvr",pos:Noun,traits:[Abbreviation]),
    (lemma:"u",pos:Noun,traits:[Abbreviation]),
    (lemma:"ua",pos:Noun,traits:[Abbreviation]),
    (lemma:"ui",pos:Noun,traits:[Abbreviation]),
    (lemma:"uo",pos:Noun,traits:[Abbreviation]),
    (lemma:"uő",pos:Noun,traits:[Abbreviation]),
    (lemma:"v",pos:Noun,traits:[Abbreviation]),
    (lemma:"vki",pos:Noun,traits:[Abbreviation]),
    (lemma:"vmi",pos:Noun,traits:[Abbreviation]),
    (lemma:"vsz",pos:Noun,traits:[Abbreviation]),
    (lemma:"vö",pos:Noun,traits:[Abbreviation]),
    (lemma:"zrt",pos:Noun,traits:[Abbreviation]),
    (lemma:"É",pos:Noun,traits:[Abbreviation]),
    (lemma:"ÉK",pos:Noun,traits:[Abbreviation]),
    (lemma:"ÉNy",pos:Noun,traits:[Abbreviation]),
    (lemma:"áll",pos:Noun,traits:[Abbreviation]),
    (lemma:"ált",pos:Noun,traits:[Abbreviation]),
    (lemma:"ápr",pos:Noun,traits:[Abbreviation]),
    (lemma:"évf",pos:Noun,traits:[Abbreviation]),
    (lemma:"özv",pos:Noun,traits:[Abbreviation]),
    (lemma:"úm",pos:Noun,traits:[Abbreviation]),
    (lemma:"ún",pos:Noun,traits:[Abbreviation]),
    (lemma:"üi",pos:Noun,traits:[Abbreviation]),

    // NOM-PL-003 names `férfi` as the noun that takes a low linking vowel before the plural
    // although it ends in a vowel: `férfiak` 633,484 against `férfik` 285 [WC2].
    (lemma:"férfi",pos:Noun,traits:[Back,Low,BareAccusative,LinkedPlural,HarmonyOptional]),

    // The `ajtó` type is measured, not listed: `NOM-STEM-013` is a possessive-only alternation,
    // so `cargo xtask morphdb` emits the two candidate possessives per `ó`/`ő` noun and
    // `measure_possessive_alt.py` asks the corpus which one the language uses. 131 lemmas take it,
    // 2,854 do not and 30 take both. The class was listed here until the measurement existed, and
    // the corpus contradicts one of the rulebook's own members: `szőlője` 2,828 : `szőleje` 445.
    //
    // `első` is the one member the measurement cannot see. It is an ordinal, so the corpus files
    // its forms under the lemma `egy` with a numeral tag rather than under `első`, and the
    // lemma filter that keeps homographs from voting excludes them: `elseje` is 23,762 and
    // `elsején` 65,916 against `elsője` 409 [WC2], all tagged `egy`/Num.
    (lemma:"első",pos:Noun,traits:[PossessiveAlt,PossessiveA]),
    (lemma:"tüdő",pos:Noun,traits:[PossessiveAlt,PossessiveA]),
    (lemma:"velő",pos:Noun,traits:[PossessiveAlt,PossessiveA]),
    (lemma:"vő",pos:Noun,traits:[PossessiveAlt,PossessiveA]),
    (lemma:"hadfi",pos:Noun,traits:[Low,LinkedPlural]),

    // Back-harmony loans ending in a neutral vowel. Their spelling computes as front, and morphdb
    // carries no flag either way, so without these the dative came out front: `havernek` instead of
    // `havernak`. Membership and the ratios are from the induced list
    // `local/lists/neutral-final-loan-harmony.tsv`, which found 8 members among 163 candidates; the
    // comment on each row is its dative count, back against front.
    //
    // Rules: PH-HARM-011
    // A supplement row replaces the converted one, so each carries that row's accusative and
    // possessive too; `haver` takes `PossessiveJa` against the conversion's `PossessiveA`
    // (`haverja` 10,264 : `havera` 5 [WC2]).
    (lemma:"haver",pos:Noun,traits:[Back,BareAccusative,PossessiveJa]),  // 71,848 : 634
    (lemma:"matek",pos:Noun,traits:[Back,LinkedAccusative,PossessiveJa,HarmonyOptional]),  // 18,299 : 276
    (lemma:"fater",pos:Noun,traits:[Back,BareAccusative,PossessiveJa,HarmonyOptional]),  // 5,385 : 190
    (lemma:"balek",pos:Noun,traits:[Back,LinkedAccusative,PossessiveJa,HarmonyOptional]),  // 5,215 : 225
    (lemma:"kolesz",pos:Noun,traits:[Back,BareAccusative,PossessiveA,HarmonyOptional]),  // 2,920 : 320
    (lemma:"maszek",pos:Noun,traits:[Back,LinkedAccusative,PossessiveJa,HarmonyOptional]),  // 2,084 : 80
    (lemma:"krapek",pos:Noun,traits:[Back,LinkedAccusative,PossessiveJa,HarmonyOptional]),  // 436 : 39
    (lemma:"pajesz",pos:Noun,traits:[Back,BareAccusative,PossessiveA,HarmonyOptional]),  // 271 : 14

    // Interrogative, relative and universal quantifiers. Another closed class from `det.lexicon`
    // and `pronoun.lexicon`, neither of which the converter reads. `mennyi` was rejected outright.
    //
    // Rules: PND-QUANT, PND-DEM-001
    (lemma:"mennyi",pos:Pronoun,traits:[SingularOnly]),
    (lemma:"ahány",pos:Determiner),
    (lemma:"amennyi",pos:Determiner),
    (lemma:"semennyi",pos:Pronoun),
    (lemma:"bármennyi",pos:Pronoun),
    (lemma:"akármennyi",pos:Pronoun),
    // The `vala-`, `bár-` and `akár-` compounds of `ki` and `mi`. Their spelling computes back
    // harmony from the `a`/`á` of the prefix, but the pronoun they are built on governs and they
    // take front suffixes throughout: `valakinek` 413,614 against `valakinak` 213, `bárkinek`
    // 82,552 against `bárkinak` 10, `akárminek` 1,800 against `akárminak` 0 [WC2]. The same series
    // whose spelling already computes front (`senki`, `semmi`, `mindenki`) needs no mark.
    //
    // `másik` is not one of them and is genuinely back (`másiknak` 73,822 : `másiknek` 9).
    //
    // Rules: PH-HARM-011
    // Missing from the conversion altogether.
    (lemma:"valamelyik",pos:Pronoun),
    (lemma:"némi",pos:Determiner),

    (lemma:"mindenki",pos:Pronoun),
    (lemma:"akármelyik",pos:Pronoun),
    (lemma:"mindenféle",pos:Adjective),
    // PND-INT-001's inventory, which morphdb does not have at all. Each missing one takes its
    // whole prefixed series with it (`valahová`, `bárhová`, `ameddig`, `valamiféle`), because
    // PND-INDF-001 builds the series on these bases. `hova` is the variant and is an entry
    // already; `hová` is the standard spelling.
    (lemma:"hová",pos:Adverb,traits:[Back]),
    // `hány` is in morphdb as a noun and a verb ('vomit'), never as the interrogative quantity
    // word PND-INT-001 lists, so its collective `hányan` had no category to attach to. `mennyi`
    // and `melyik` are pronouns here already.
    (lemma:"hány",pos:Pronoun,traits:[Back,Low]),
    (lemma:"meddig",pos:Adverb),
    (lemma:"miféle",pos:Adjective),
    (lemma:"bármiféle",pos:Adjective),
    (lemma:"semmiféle",pos:Adjective),

    // Quantifiers, determiner-like adjectives and reciprocals. Closed classes that morphdb keeps in
    // `det.lexicon` and `pronoun.lexicon`, neither of which the converter reads. Measured as a
    // leading cause of false rejection on normative text.
    //
    // Rules: PND-INDF-004, PND-DEM-001, PND-PERS-001
    // `sok`, `kevés` and `több` grade and inflect like adjectives (`kevesebbet`, `sokkal`), so they
    // are typed as adjectives rather than determiners; `Quantity` is what lets the collective and
    // the multiplicative reach them and no other adjective (`sokan`, `kevésszer`, `rengetegszer`).
    (lemma:"több",pos:Adjective,traits:[Quantity]),
    (lemma:"sok",pos:Adjective,traits:[Low,Quantity]),
    (lemma:"kevés",pos:Adjective,traits:[Shortening,Low,Quantity]),
    (lemma:"számos",pos:Adjective,traits:[Low,Quantity]),
    (lemma:"számtalan",pos:Adjective,traits:[Quantity]),
    (lemma:"temérdek",pos:Adjective,traits:[Quantity]),
    (lemma:"rengeteg",pos:Adjective,traits:[Quantity]),
    (lemma:"elég",pos:Adjective,traits:[Low,Shortening,Quantity]),
    (lemma:"minden",pos:Pronoun),
    (lemma:"mindegyik",pos:Pronoun),
    (lemma:"némely",pos:Pronoun),
    (lemma:"néhány",pos:Pronoun),
    (lemma:"bármely",pos:Pronoun),
    (lemma:"bármelyik",pos:Pronoun),
